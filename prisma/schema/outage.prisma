model Outage {
  id           String         @id @default(uuid())
  zoneId       String
  reportedBy   String
  technicianId String?

  priority     OutagePriority @default(MEDIUM)
  status       OutageStatus   @default(REPORTED)

  title        String
  description  String?

  startedAt    DateTime       @default(now())
  restoredAt   DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  // Relations
  zone       Zone       @relation(fields: [zoneId], references: [id])
  reporter   User       @relation(fields: [reportedBy], references: [id])
  technician Technician? @relation(fields: [technicianId], references: [id])

  notifications Notification[]

  @@index([zoneId])
  @@index([reportedBy])
  @@index([technicianId])
  @@index([status])
  @@index([priority])
  @@index([deletedAt])
  @@map("outages")
}