model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  author_role       UserRole

  action     String
  entityType String
  entityId   String

  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}